# Video AI Tools - environment configuration example
# Copy to .env and fill in only the values you need.
# NEVER commit .env or real API tokens.

# Hugging Face
# Optional. Improves model download rate limits and download speed.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# AI model/cache location
# The transcription scripts default to ./aimodels.
AI_MODELS_DIR=./aimodels

# Whisper transcription defaults
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5

# Optional local Ollama / OpenAI-compatible AI endpoint
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=

# Optional OpenAI-compatible API
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
